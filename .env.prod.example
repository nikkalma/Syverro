# Copy to .env on the VPS (next to docker-compose.prod.yml):
#   cp .env.prod.example .env

# --- Images (published by GHA to GHCR) ---
IMAGE_TAG=main
# BACKEND_IMAGE=ghcr.io/nikkalma/syverro-backend:main
# WEB_IMAGE=ghcr.io/nikkalma/syverro-web:main

# --- Database ---
POSTGRES_USER=syverro
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=syverro

# --- Backend ---
ENVIRONMENT=production
SECRET_KEY=replace-with-long-random-string
TELEGRAM_BOT_TOKEN=
RESEND_API_KEY=re_...
EMAIL_FROM=Syverro <noreply@syverro.com>
SITE_URL=https://syverro.com
AUTH_COOKIE_DOMAIN=syverro.com

# --- SyvAI (forwarded to the backend container by docker-compose.prod.yml) ---
# SYVAI_OPENAI_API_KEY is REQUIRED for OpenAI generation; discovery can run
# without it. Set to a real OpenAI key in the production .env only.
SYVAI_OPENAI_API_KEY=
SYVAI_OPENAI_BASE_URL=https://api.openai.com/v1
SYVAI_OPENAI_MODEL=gpt-4o-mini
SYVAI_PROVIDER_TIMEOUT_SECONDS=60
SYVAI_PROVIDER_TEMPERATURE=0
SYVAI_PROVIDER_MAX_TOKENS=4096
# Discovery must be explicitly enabled.
SYVAI_DISCOVERY_ENABLED=false
SYVAI_DISCOVERY_PROVIDER=wikipedia
SYVAI_DISCOVERY_PROVIDERS=wikipedia,loc,archive
SYVAI_DISCOVERY_MAX_CANDIDATES=5
SYVAI_DISCOVERY_MAX_PER_FAMILY=2
SYVAI_DISCOVERY_DETAIL_MAX_PER_RUN=6
SYVAI_DISCOVERY_TIMEOUT_SECONDS=15
SYVAI_DISCOVERY_MAX_PAGE_BYTES=500000
SYVAI_DISCOVERY_USER_AGENT=SyverroSyvAI/0.2 (+https://syverro.com)

# --- GHCR login (for private packages; optional if packages are public) ---
# GHCR_USER=nikkalma
# GHCR_TOKEN=ghp_...   # classic PAT with read:packages
