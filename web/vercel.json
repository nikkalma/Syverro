{
  "buildCommand": "npm install && npx vite build",
  "outputDirectory": "dist",
  "devCommand": "npx vite",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/(api|auth)(.*)",
      "destination": "https://api.syverro.com/$1/$2"
    },
    {
      "source": "/health",
      "destination": "https://api.syverro.com/health"
    },
    {
      "source": "/sync",
      "destination": "https://api.syverro.com/sync"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}