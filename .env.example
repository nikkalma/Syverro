# Local docker compose (.env in repo root)

POSTGRES_USER=syverro
POSTGRES_PASSWORD=change-me
POSTGRES_DB=syverro
SECRET_KEY=change-me-in-production

# Baked into the web image at build time (browser must reach this URL)
VITE_API_URL=http://localhost:8000

# Optional: run local compose against published images instead of building
# BACKEND_IMAGE=ghcr.io/nikkalma/syverro-backend:main
# WEB_IMAGE=ghcr.io/nikkalma/syverro-web:main
