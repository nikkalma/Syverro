# Copy to .env on the VPS (next to docker-compose.prod.yml):
#   cp .env.prod.example .env

# --- Images (published by GHA to GHCR) ---
IMAGE_TAG=main
# BACKEND_IMAGE=ghcr.io/nikkalma/syverro-backend:main
# WEB_IMAGE=ghcr.io/nikkalma/syverro-web:main

# --- Database ---
POSTGRES_USER=syverro
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=syverro

# --- Backend ---
SECRET_KEY=replace-with-long-random-string

# --- GHCR login (for private packages; optional if packages are public) ---
# GHCR_USER=nikkalma
# GHCR_TOKEN=ghp_...   # classic PAT with read:packages
